# Copy to .env and fill in real values.

# Postgres password for the bundled postgres container.
# Generate: openssl rand -hex 32
POSTGRES_PASSWORD=change-me-postgres-password

# JWT signing secret for user sessions AND captcha HMAC. Long random string.
# Generate: openssl rand -hex 64
JWT_SECRET=change-me-jwt-secret-make-this-long-and-random

# Optional log level
RUST_LOG=info,cagnotte=info

# For local dev (cargo run) outside compose, set DATABASE_URL manually:
# DATABASE_URL=postgres://cagnotte:password@localhost:5432/cagnotte
